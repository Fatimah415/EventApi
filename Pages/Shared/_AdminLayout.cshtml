<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EventBoard Admin</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f0f2f5; color: #1a1a2e; }
        .sidebar { position: fixed; top: 0; left: 0; height: 100vh; width: 220px; background: #1a1a2e; color: #fff; padding: 0; display: flex; flex-direction: column; }
        .sidebar-brand { padding: 24px 20px; font-size: 1.2rem; font-weight: 700; border-bottom: 1px solid #2d2d44; letter-spacing: .5px; }
        .sidebar-brand span { color: #6c63ff; }
        .sidebar nav { flex: 1; padding: 16px 0; }
        .sidebar nav a { display: flex; align-items: center; gap: 10px; padding: 12px 20px; color: #a0aec0; text-decoration: none; font-size: .93rem; transition: all .2s; }
        .sidebar nav a:hover, .sidebar nav a.active { background: #2d2d44; color: #fff; border-left: 3px solid #6c63ff; }
        .sidebar nav a .icon { width: 18px; text-align: center; }
        .sidebar-footer { padding: 16px 20px; border-top: 1px solid #2d2d44; font-size: .8rem; color: #718096; }
        .main { margin-left: 220px; min-height: 100vh; }
        .topbar { background: #fff; padding: 16px 28px; border-bottom: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between; }
        .topbar h1 { font-size: 1.25rem; font-weight: 600; }
        .topbar .user-badge { background: #6c63ff; color: #fff; border-radius: 50%; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: .9rem; }
        .content { padding: 28px; }
        .card { background: #fff; border-radius: 10px; box-shadow: 0 1px 3px rgba(0,0,0,.08); padding: 24px; margin-bottom: 24px; }
        .card-title { font-size: 1rem; font-weight: 600; margin-bottom: 16px; color: #2d3748; }
        .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 24px; }
        .stat-card { background: #fff; border-radius: 10px; box-shadow: 0 1px 3px rgba(0,0,0,.08); padding: 20px; }
        .stat-label { font-size: .8rem; color: #718096; text-transform: uppercase; letter-spacing: .5px; margin-bottom: 8px; }
        .stat-value { font-size: 2rem; font-weight: 700; color: #1a1a2e; }
        .stat-card.purple .stat-value { color: #6c63ff; }
        .stat-card.green .stat-value { color: #38a169; }
        .stat-card.orange .stat-value { color: #dd6b20; }
        .stat-card.red .stat-value { color: #e53e3e; }
        table { width: 100%; border-collapse: collapse; font-size: .9rem; }
        th { background: #f7f8fa; text-align: left; padding: 10px 14px; font-size: .8rem; font-weight: 600; color: #718096; text-transform: uppercase; letter-spacing: .4px; border-bottom: 1px solid #e2e8f0; }
        td { padding: 11px 14px; border-bottom: 1px solid #f0f2f5; vertical-align: middle; }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: #fafbff; }
        .badge { display: inline-block; padding: 3px 10px; border-radius: 12px; font-size: .76rem; font-weight: 600; }
        .badge-admin { background: #e9e7ff; color: #6c63ff; }
        .badge-user { background: #e6fffa; color: #38a169; }
        .badge-confirmed { background: #e6fffa; color: #38a169; }
        .badge-pending { background: #fffbeb; color: #d69e2e; }
        .badge-cancelled { background: #fff5f5; color: #e53e3e; }
        .alert { padding: 14px 18px; border-radius: 8px; margin-bottom: 20px; font-size: .9rem; }
        .alert-error { background: #fff5f5; border: 1px solid #fed7d7; color: #c53030; }
        .alert-info { background: #ebf4ff; border: 1px solid #bee3f8; color: #2b6cb0; }
        .tab-bar { display: flex; gap: 4px; margin-bottom: 20px; border-bottom: 2px solid #e2e8f0; }
        .tab { padding: 10px 20px; font-size: .9rem; font-weight: 500; color: #718096; text-decoration: none; border-bottom: 2px solid transparent; margin-bottom: -2px; }
        .tab.active, .tab:hover { color: #6c63ff; border-bottom-color: #6c63ff; }
        .btn { display: inline-block; padding: 8px 16px; border-radius: 6px; font-size: .85rem; font-weight: 600; cursor: pointer; text-decoration: none; border: none; }
        .btn-danger { background: #fff5f5; color: #e53e3e; border: 1px solid #feb2b2; }
        .btn-danger:hover { background: #fed7d7; }
        .search-box { width: 100%; padding: 9px 14px; border: 1px solid #e2e8f0; border-radius: 8px; font-size: .9rem; margin-bottom: 16px; }
        .search-box:focus { outline: none; border-color: #6c63ff; }
        .empty-state { text-align: center; padding: 40px; color: #a0aec0; }
        .chart-bar-wrap { display: flex; align-items: flex-end; gap: 6px; height: 120px; margin-top: 12px; }
        .chart-bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px; height: 100%; justify-content: flex-end; }
        .chart-bar { background: #6c63ff; border-radius: 4px 4px 0 0; width: 100%; min-height: 4px; transition: height .3s; }
        .chart-label { font-size: .65rem; color: #718096; white-space: nowrap; }
        .chart-val { font-size: .65rem; color: #6c63ff; font-weight: 600; }
        form.delete-form { display: inline; }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-brand">Event<span>Board</span> Admin</div>
        <nav>
            <a href="/Admin" class="@(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "active" : "")">
                <span class="icon">📊</span> Dashboard
            </a>
            <a href="/Admin/Events" class="@(ViewData["ActivePage"]?.ToString() == "Events" ? "active" : "")">
                <span class="icon">📅</span> Events
            </a>
            <a href="/Admin/Users" class="@(ViewData["ActivePage"]?.ToString() == "Users" ? "active" : "")">
                <span class="icon">👥</span> Users
            </a>
            <a href="/Admin/Bookings" class="@(ViewData["ActivePage"]?.ToString() == "Bookings" ? "active" : "")">
                <span class="icon">🎟️</span> Bookings
            </a>
        </nav>
        <div class="sidebar-footer">EventBoard API v1.0</div>
    </div>
    <div class="main">
        <div class="topbar">
            <h1>@ViewData["Title"]</h1>
            <div class="user-badge">A</div>
        </div>
        <div class="content">
            @RenderBody()
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

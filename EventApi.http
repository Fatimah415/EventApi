@EventApi_HostAddress = http://localhost:5289

### Register a user
POST {{EventApi_HostAddress}}/api/users/register
Content-Type: application/json

{
  "name": "Test User",
  "email": "test@eventboard.com",
  "password": "Secret123!"
}

### Get all events
GET {{EventApi_HostAddress}}/api/events
Accept: application/json

### Get event by id
GET {{EventApi_HostAddress}}/api/events/1
Accept: application/json

### Create an event (UserId must exist)
POST {{EventApi_HostAddress}}/api/events
Content-Type: application/json

{
  "title": "Tech Meetup",
  "description": "Intro to .NET",
  "eventDate": "2026-08-01T18:00:00Z",
  "location": "Lahore",
  "category": "Tech",
  "userId": 1
}

### Update an event
PUT {{EventApi_HostAddress}}/api/events/1
Content-Type: application/json

{
  "title": "Tech Meetup (updated)",
  "description": "Updated description",
  "eventDate": "2026-08-02T18:00:00Z",
  "location": "Karachi",
  "category": "Tech"
}

### Delete an event
DELETE {{EventApi_HostAddress}}/api/events/1
